# Configure these in your private .env or hosting dashboard. Never commit real keys.
# A provider appears only when BOTH its API key and model ID are set.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
COHERE_API_KEY=
COHERE_MODEL=
# Meta Llama models are hosted by inference providers; Together is configured here.
TOGETHER_API_KEY=
TOGETHER_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
# Optional custom OpenAI-compatible endpoint (HTTPS required).
CUSTOM_API_BASE=
CUSTOM_API_KEY=
CUSTOM_MODEL=
DEFAULT_AI_PROVIDER=gemini
RATE_LIMIT_PER_MINUTE=20
